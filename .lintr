linters: linters_with_defaults(
    line_length_linter = line_length_linter(100L),
    object_name_linter = object_name_linter(
      styles = c("snake_case", "camelCase", "CamelCase", "SNAKE_CASE", "dotted.case", "symbols"),
      regexes = c(saigeMixed = "^[a-zA-Z][a-zA-Z0-9]*(_[a-zA-Z0-9]+)*$")
    )
  )
encoding: "UTF-8"
