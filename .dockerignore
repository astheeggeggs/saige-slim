# The runtime image carries the installed package and three scripts, nothing
# else. Everything the build stage needs is listed in docker/Dockerfile's
# COPY lines; this file keeps the context small and keeps local state out.
.pixi/
pixi.lock.bak
plink-ng/
harness/*
!harness/build.sh
!harness/tools/
harness/tools/*
!harness/tools/aou_sigma_pd_check.R
tests/
docs/
man/
extdata/input/
extdata/output/
extdata/*.sh
extdata/*.md
.git/
.github/
.githooks/
*.o
*.so
*.log
LEDGER.md
CLAUDE.md
