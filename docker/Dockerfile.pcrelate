# pcrelate_to_mtx.py (and king_to_mtx.py) as a dsub-able image: PC-Relate kinship
# from an LD-pruned bed or pgen to SAIGE's .mtx, the rung between KING-robust and
# a dense GRM for an admixed cohort (docs/state/handoff-2026-10-31-pcrelate.md).
#
# WHY THIS EXISTS SEPARATELY from docker/Dockerfile and Dockerfile.plink2:
#   * the SAIGE runtime image carries no python/numpy, and adding them to
#     `[feature.runtime]` regenerates pixi.lock, a gated change;
#   * AoU's dsub workers have no external IP, so they cannot pull a public
#     python image or pip-install Pgenlib at run time; the dependencies have to
#     be baked in and the image has to live in the project's own gcr.io.
#
# The two tools are COPIED IN, so the image tag names the exact tool version
# that made a matrix; rebuild when either tool changes. The selftest runs at
# build time (15 s): an image that cannot recover planted relatives, or whose
# Pgenlib does not import, fails HERE, not in a dsub job.
#
#   docker build -f docker/Dockerfile.pcrelate -t pcrelate:$(git rev-parse --short HEAD) .
#   docker tag  pcrelate:<hash> gcr.io/weighty-elf-452116-c7/pcrelate:<hash>
#   docker push gcr.io/weighty-elf-452116-c7/pcrelate:<hash>
#
# numpy's wheel carries OpenBLAS; --threads sets OPENBLAS_NUM_THREADS before
# the import, so give the job as many threads as the machine has vCPUs.

FROM python:3.11-slim

RUN pip install --no-cache-dir numpy==1.26.4 pandas==2.2.3 matplotlib==3.9.2 Pgenlib==0.95.1   # pandas+matplotlib: king_to_mtx.py compare/plot

COPY harness/tools/pcrelate_to_mtx.py harness/tools/king_to_mtx.py /usr/local/bin/
RUN chmod +x /usr/local/bin/pcrelate_to_mtx.py /usr/local/bin/king_to_mtx.py

# an image whose tool does not pass its own controls must fail here
RUN cd /tmp && python3 /usr/local/bin/pcrelate_to_mtx.py selftest --threads 2 \
 && python3 /usr/local/bin/king_to_mtx.py selftest \
 && rm -rf /tmp/*

CMD ["python3", "/usr/local/bin/pcrelate_to_mtx.py"]
